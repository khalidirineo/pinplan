exports[`ESP-IDF export > checks adc_oneshot_read for ESP_ERR_TIMEOUT on ADC2 and not on ADC1 1`] = `
"/*
 * PinPlan export for ESP32-S3-WROOM-1.
 * ESP-IDF v5.3+.
 * Settings: Wi-Fi on, PSRAM none, native USB off.
 * Clock rates, ADC attenuation, and the LEDC timer are export defaults. Edit
 * the PINPLAN_* macros. They are not facts from the pin database.
 * This design still has conflicts. The code below was generated anyway.
 * [warning] adc2-wifi GPIO11: GPIO11 is ADC2 channel 0. ADC2 is also used by
 * Wi-Fi. adc_oneshot_read may fail and return ESP_ERR_TIMEOUT.
 */

#include "esp_err.h"
#include "driver/gpio.h"
#include "esp_adc/adc_oneshot.h"

static adc_oneshot_unit_handle_t pinplan_adc1;
static adc_oneshot_unit_handle_t pinplan_adc2;

static void pinplan_init_adc(void)
{
    /*
     * ADC_ATTEN_DB_12 is an export default, not a fact from the pin database.
     */
    adc_oneshot_unit_init_cfg_t pinplan_adc1_cfg = {
        .unit_id = ADC_UNIT_1,
    };
    ESP_ERROR_CHECK(adc_oneshot_new_unit(&pinplan_adc1_cfg, &pinplan_adc1));
    adc_oneshot_chan_cfg_t pinplan_adc1_chan = {
        .bitwidth = ADC_BITWIDTH_DEFAULT,
        .atten = ADC_ATTEN_DB_12,
    };
    adc_oneshot_unit_init_cfg_t pinplan_adc2_cfg = {
        .unit_id = ADC_UNIT_2,
    };
    ESP_ERROR_CHECK(adc_oneshot_new_unit(&pinplan_adc2_cfg, &pinplan_adc2));
    adc_oneshot_chan_cfg_t pinplan_adc2_chan = {
        .bitwidth = ADC_BITWIDTH_DEFAULT,
        .atten = ADC_ATTEN_DB_12,
    };
    ESP_ERROR_CHECK(adc_oneshot_config_channel(pinplan_adc1, ADC_CHANNEL_0, &pinplan_adc1_chan));
    ESP_ERROR_CHECK(adc_oneshot_config_channel(pinplan_adc2, ADC_CHANNEL_0, &pinplan_adc2_chan));
}

/*
 * Label: battery.
 */
esp_err_t pinplan_adc_read_gpio1(int *raw)
{
    esp_err_t err = adc_oneshot_read(pinplan_adc1, ADC_CHANNEL_0, raw);
    ESP_ERROR_CHECK(err);
    return err;
}

/*
 * Label: sensor.
 * ADC2 is also used by Wi-Fi. adc_oneshot_read may return ESP_ERR_TIMEOUT, and
 * the raw result is then invalid.
 */
esp_err_t pinplan_adc_read_gpio11(int *raw)
{
    esp_err_t err = adc_oneshot_read(pinplan_adc2, ADC_CHANNEL_0, raw);
    if (err == ESP_ERR_TIMEOUT) {
        return err;
    }
    ESP_ERROR_CHECK(err);
    return err;
}

void pinplan_init(void)
{
    pinplan_init_adc();
}
"
`;

